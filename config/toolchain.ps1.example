# Template for config/toolchain.ps1.
#
# Normally you don't hand-write this — run tools/Detect-Toolchain.ps1 and it
# generates config/toolchain.ps1 for you with real, verified paths from your
# install. This file exists as a reference for the shape it expects.
#
# All three tool names below are confirmed real (see docs/ARCHITECTURE.md
# for sources), unlike earlier drafts of this repo that guessed at legacy
# v8.x tool names.

$CwRoot = 'C:\Freescale\CW MCU v11.2'

# Headless build driver (builds a whole Eclipse project directory)
$ECD   = "$CwRoot\eclipse\ecd.exe"

# Debugger Shell — runs TCL scripts against the target, no GUI
$CWIDE = "$CwRoot\eclipse\cwidec.exe"

# 56800E Flash Programmer
$FLASH = "$CwRoot\path\to\fflash.exe"

# GNU make, bundled with CodeWarrior — only needed if you use
# `ecd.exe -generateMakefiles` + `make` instead of `ecd.exe build` directly
$MAKE  = "$CwRoot\gnu\bin\make.exe"
