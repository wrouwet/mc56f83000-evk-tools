# Template for config/toolchain.ps1.
#
# Normally you don't hand-write this — run tools/Detect-Toolchain.ps1 and it
# generates config/toolchain.ps1 for you with real, verified paths from your
# install. This file exists as a reference for the shape it expects, and as
# a fallback if you need to set paths manually because detection found
# nothing (see docs/SETUP.md step 4).

$CwRoot = 'C:\Program Files (x86)\Freescale\CW MCU v11.2'

# Compiler, assembler, linker (command-line build tools; see
# docs/ARCHITECTURE.md for why these can't be hardcoded across versions)
$CC    = "$CwRoot\DSP56800x_EABI_Tools\command_line_tools\mwcc56800e.exe"
$ASM   = "$CwRoot\DSP56800x_EABI_Tools\command_line_tools\mwasmdsp.exe"
$LD    = "$CwRoot\DSP56800x_EABI_Tools\command_line_tools\mwld56800e.exe"

# Flash programmer (OSBDM) and Debugger Shell — names vary more; fill in
# from your install's Help\56800x_Build_Tools_Reference.pdf if
# Detect-Toolchain.ps1 didn't find them.
$FLASH = "$CwRoot\path\to\FlashProgrammer.exe"
$DEBUG = "$CwRoot\path\to\cwdebug.exe"
